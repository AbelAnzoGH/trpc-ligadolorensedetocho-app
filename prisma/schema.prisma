// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  // partialIndexes: deja declarar índices con WHERE (ver Season).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(255)
  email     String  @unique 
  verified  Boolean @default(false)    

  password  String  
  role      RoleEnumType? @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider String? @default("local")


  @@map(name: "users")

}

enum RoleEnumType {
  user
  admin
}

model Team {
  id        String @id @default(uuid())
  name      String @unique @db.VarChar(255)

  // La categoría YA NO vive aquí: se mudó a TeamSeason, porque un equipo
  // puede jugar varonil en una temporada y mixto en otra (o ambas a la vez).

  // Logo del equipo. Ambos campos son opcionales: un equipo puede existir
  // sin logo. Se guardan DOS cosas y no una:
  //   logoUrl → la dirección para mostrarlo en un <img> ("/uploads/logos/x.png")
  //   logoKey → el identificador interno que usa el almacenamiento para
  //             poder BORRAR el archivo después ("logos/x.png")
  // Hoy se parecen porque el almacenamiento es local; cuando pase a S3 la url
  // será "https://cdn.../logos/x.png" y la key seguirá siendo "logos/x.png".
  logoUrl   String?
  logoKey   String?

  // Sus inscripciones: una fila por temporada (y categoría) en la que juega.
  teamSeasons TeamSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map(name: "teams")
}

enum TeamCategoryEnumType {
  femenil
  varonil
  mixto
}

// La LIGA: LDT, LDT SHADOWS, LDT INTERPREPAS. Permanente, como Team y Player.
// Cada liga lleva su propia numeración de temporadas.
model League {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(255) // "LDT SHADOWS"
  slug String @unique @db.VarChar(60)  // "shadows" → /ligas/shadows

  seasons Season[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map(name: "leagues")
}

// Una TEMPORADA de una liga. "LDT VII" = liga LDT + number 7.
// El nombre bonito se calcula (liga + número romano), no se guarda.
model Season {
  id String @id @default(uuid())

  leagueId String
  // Restrict: no se puede borrar una liga que ya tiene temporadas.
  league   League @relation(fields: [leagueId], references: [id], onDelete: Restrict)

  number Int // 7 → "VII"

  status SeasonStatusEnumType @default(inscripciones)

  startDate DateTime?
  endDate   DateTime?

  teamSeasons TeamSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una liga no puede tener dos "temporada 7".
  @@unique([leagueId, number])
  // Máximo UNA temporada activa por liga. Índice único PARCIAL: solo indexa
  // las filas con status = 'activa'. Se creó a mano en la migración
  // agregar_ligas_y_temporadas; declararlo aquí (con el mismo nombre en `map`)
  // evita que `prisma migrate dev` proponga borrarlo.
  // No usar findUnique por leagueId: Prisma lo ofrece, pero NO es único
  // entre temporadas cerradas.
  @@unique([leagueId], where: raw("\"status\" = 'activa'"), map: "seasons_una_activa_por_liga")

  @@map(name: "seasons")
}

// Ciclo de vida de una temporada:
//   inscripciones → se preparan equipos y plantillas; todavía no es "la actual"
//   activa        → se está jugando; máximo una por liga
//   cerrada       → congelada; su historial ya no cambia
enum SeasonStatusEnumType {
  inscripciones
  activa
  cerrada
}

// La INSCRIPCIÓN de un equipo en una temporada, en una categoría.
// "Patito" en LDT VII varonil y "Patito" en LDT VII mixto son DOS filas,
// cada una con su propio plantel y sus propias estadísticas.
// Regla: todo lo que es "de la temporada" vive aquí y nace en cero.
model TeamSeason {
  id String @id @default(uuid())

  seasonId String
  teamId   String

  // Restrict en ambos: borrar una temporada o un equipo por error destruiría
  // el historial que este modelo existe para proteger.
  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  category TeamCategoryEnumType

  // Estadísticas del equipo en ESTA inscripción (se capturan a mano por ahora).
  gamesPlayed   Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  ties          Int @default(0)
  pointsFor     Int @default(0) // desempate de la tabla
  pointsAgainst Int @default(0) // desempate de la tabla

  memberships TeamMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El mismo equipo puede estar en varias categorías de una temporada,
  // pero no dos veces en la misma categoría.
  @@unique([seasonId, teamId, category])
  @@index([teamId])

  @@map(name: "team_seasons")
}

// La PERSONA. Lo que no cambia según el equipo en el que juegue.
model Player {
  id        String @id @default(uuid())
  name      String @db.VarChar(255)
  lastName  String @db.VarChar(255)

  age       Int
  height    Int    // en centímetros

  memberships TeamMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map(name: "players")
}

// La PARTICIPACIÓN de una persona en UNA inscripción (equipo + temporada + categoría).
// Si Juan juega en el varonil y en el mixto, hay un Player y dos TeamMembership:
// mismo nombre y edad, pero jersey, posiciones y estadísticas independientes.
// Es un REGISTRO HISTÓRICO: cada temporada nace una fila nueva; las viejas
// no se editan ni se borran, y así las estadísticas quedan para la posteridad.
model TeamMembership {
  id       String @id @default(uuid())

  playerId     String
  teamSeasonId String

  // Borrar a la persona borra sus membresías (ya no juega en ningún lado).
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Borrar una inscripción NO se permite si todavía tiene jugadores: el
  // controlador lanza CONFLICT antes de llegar aquí, con un mensaje entendible.
  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Restrict)

  jerseyNumber Int
  positions    PlayerPositionEnumType[]

  // Foto del jugador CON ESTE UNIFORME. Va aquí y no en Player por la misma
  // razón que las estadísticas: si Juan juega en el varonil y en el mixto,
  // son dos fotos distintas de la misma persona.
  // Mismo par de columnas que el logo del equipo:
  //   photoUrl → para el <img src="...">
  //   photoKey → para poder borrar el archivo después
  photoUrl     String?
  photoKey     String?

  // Estadísticas: son de esta membresía, no de la persona.
  touchdowns      Int @default(0)
  interceptions   Int @default(0)
  touchdownPasses Int @default(0)
  safeties        Int @default(0)
  gamesPlayed     Int @default(0)

  availableForPlayoffs Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una persona no puede estar dos veces en la misma inscripción...
  @@unique([playerId, teamSeasonId])
  // ...y dentro de una inscripción, dos jugadores no pueden traer el mismo número.
  @@unique([teamSeasonId, jerseyNumber])
  // La regla "no en dos equipos de la MISMA categoría en la misma temporada"
  // cruza tres tablas, así que la hace cumplir el controlador, no la base.

  @@map(name: "team_memberships")
}

enum PlayerPositionEnumType {
  QB // Quarterback
  C  // Centro
  WR // Receptor
  RB // Corredor
  FL // Flanker
  RU // Rusher
  LB // Linebacker
  CB // Esquinero
  S  // Safety
  DB // Defensivo
}
